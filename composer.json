{
    "name": "caturseptian/laravel-indonesia-territory",
    "description": "Indonesian administrative regions (Kemendagri codes) for Laravel: provinces, regencies, districts, villages, postal codes, coordinates, boundaries and islands. Install once, eject for zero runtime dependency.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "indonesia",
        "wilayah",
        "kode-wilayah",
        "kodifikasi-wilayah",
        "provinsi",
        "kabupaten",
        "kota",
        "kecamatan",
        "kelurahan",
        "desa",
        "kode-pos",
        "kemendagri",
        "region",
        "territory",
        "geojson"
    ],
    "homepage": "https://github.com/caturseptian/laravel-indonesia-territory",
    "authors": [
        {
            "name": "Catur Septian",
            "homepage": "https://caturseptian.github.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-zlib": "*",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "CaturSeptian\\IndonesiaTerritory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CaturSeptian\\IndonesiaTerritory\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CaturSeptian\\IndonesiaTerritory\\IndonesiaTerritoryServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
